# Copia este archivo como .env.local (desarrollo) o crea estas variables en Vercel.

# Obligatoria para la IA: clave de https://console.anthropic.com
ANTHROPIC_API_KEY=

# Recomendada: código que la app pedirá una vez para usar la IA.
# Sin él, cualquiera que conozca la URL podría gastar tu saldo de la API.
IRAKURRI_ACCESS_CODE=

# Opcional: modelo de Claude (por defecto claude-sonnet-5-5).
# claude-haiku-5-5 es más barato y rápido, con algo menos de calidad en traducciones.
AI_MODEL=
